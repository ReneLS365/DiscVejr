<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101714" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="◉  DISCVEJR" android:textColor="#B2F26A"
            android:textStyle="bold" android:textSize="17sp" android:letterSpacing="0.11" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Vejr til discgolf"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="30sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vind og vindstød betyder mere end en traditionel golfvurdering. Widgetten viser de vigtigste oplysninger direkte på startskærmen."
            android:textColor="#B5C5B9" android:textSize="14sp" />
        <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:background="@drawable/bg_widget" android:padding="20dp"
            android:text="Indlæser vejr…" android:textColor="#FFFFFF" android:textSize="16sp" android:lineSpacingExtra="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="VEJROMRÅDE"
            android:textColor="#B2F26A" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:id="@+id/current_place" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:text="Kvaglund, Esbjerg"
            android:textColor="#FFFFFF" android:textSize="18sp" />
        <Button android:id="@+id/kvaglund_button" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Vælg Kvaglund (standard)" android:textAllCaps="false"
            android:backgroundTint="#31472F" android:textColor="#FFFFFF" />
        <Button android:id="@+id/location_button" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Brug min position" android:textAllCaps="false"
            android:backgroundTint="#31472F" android:textColor="#FFFFFF" />
        <Button android:id="@+id/refresh_button" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Opdater vejret nu" android:textAllCaps="false"
            android:backgroundTint="#B2F26A" android:textColor="#142017" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="SÅDAN TILFØJES WIDGETTEN"
            android:textColor="#B2F26A" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="1. Hold fingeren på et tomt område af startskærmen.\n2. Tryk Widgets.\n3. Find DiscVejr.\n4. Træk widgetten til startskærmen (4 × 3 felter).\n5. Tryk ↻ på widgetten for manuel opdatering."
            android:textColor="#D6E4DA" android:textSize="14sp" android:lineSpacingExtra="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Vejrdata: Open-Meteo.com. Opdateres ca. hvert 30. minut, afhængigt af Androids batteristyring. Scoren 0-100 er en uofficiel, discgolf-specifik vurdering og erstatter ikke egne observationer eller varsler. Ingen reklamer, ingen brugerprofil og ingen sporing."
            android:textColor="#8FA196" android:textSize="12sp" android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
